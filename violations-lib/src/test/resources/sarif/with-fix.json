{
  "$schema": "https://schemastore.azurewebsites.net/schemas/json/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ExampleTool",
          "rules": [
            {
              "id": "UseStringValueOf",
              "name": "UseStringValueOf"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "UseStringValueOf",
          "level": "warning",
          "message": {
            "text": "Use String.valueOf(x) instead of \"\" + x"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/main/java/Main.java"
                },
                "region": {
                  "startLine": 10
                }
              }
            }
          ],
          "fixes": [
            {
              "description": {
                "text": "Replace with String.valueOf(x)"
              },
              "artifactChanges": [
                {
                  "artifactLocation": {
                    "uri": "src/main/java/Main.java"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 10,
                        "startColumn": 5,
                        "endColumn": 20
                      },
                      "insertedContent": {
                        "text": "String.valueOf(x)"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
